const CONFIG = {

  HOJA: "SOLICITUDES",

  CORREO_COMERCIAL: "comercial@grupovyd.com.pe",

  ZONA_HORARIA: "America/Lima",

  ORIGENES_VALIDOS: [
    "HERO",
    "NAVBAR",
    "NOSOTROS",
    "CONTACTO"
  ]

};


//==================================================
// RECIBIR SOLICITUD WEB
//==================================================

function doPost(e) {

  try {

    if (!e || !e.postData || !e.postData.contents) {

      return crearRespuesta(false, "Solicitud inválida");

    }

    const datos = JSON.parse(e.postData.contents);


    //==================================================
    // HONEYPOT ANTI-BOT
    //==================================================

    if (datos.website) {

      return crearRespuesta(true, "Solicitud recibida");

    }


    //==================================================
    // LIMPIAR DATOS
    //==================================================

    const origen = limpiarTexto(datos.origen, 20).toUpperCase();

    const nombre = limpiarTexto(datos.nombre, 120);

    const empresa = limpiarTexto(datos.empresa, 150);

    const ruc = limpiarTexto(datos.ruc, 11);

    const correo = limpiarTexto(datos.correo, 150);

    const telefono = limpiarTexto(datos.telefono, 9);

    const feria = limpiarTexto(datos.feria, 150);

    const tipoStand = limpiarTexto(datos.tipoStand, 100);

    const medidas = limpiarTexto(datos.medidas, 100);

    const presupuesto = limpiarTexto(datos.presupuesto, 100);

    const comentarios = limpiarTexto(datos.comentarios, 1000);


    //==================================================
    // VALIDACIONES
    //==================================================

    if (!CONFIG.ORIGENES_VALIDOS.includes(origen)) {

      return crearRespuesta(false, "Origen inválido");

    }


    if (
      !nombre ||
      !empresa ||
      !ruc ||
      !correo ||
      !telefono ||
      !feria ||
      !tipoStand ||
      !medidas ||
      !presupuesto
    ) {

      return crearRespuesta(false, "Faltan campos obligatorios");

    }


    if (!/^\d{11}$/.test(ruc)) {

      return crearRespuesta(false, "RUC inválido");

    }


    if (!/^\d{9}$/.test(telefono)) {

      return crearRespuesta(false, "Teléfono inválido");

    }


    if (!validarCorreo(correo)) {

      return crearRespuesta(false, "Correo inválido");

    }


    //==================================================
    // FECHA Y HORA PERÚ
    //==================================================

    const ahora = new Date();

    const fecha = Utilities.formatDate(
      ahora,
      CONFIG.ZONA_HORARIA,
      "dd/MM/yyyy"
    );

    const hora = Utilities.formatDate(
      ahora,
      CONFIG.ZONA_HORARIA,
      "HH:mm:ss"
    );


    //==================================================
    // GUARDAR EN GOOGLE SHEETS
    //==================================================

    const lock = LockService.getScriptLock();

    lock.waitLock(10000);

    try {

      const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();

      const hoja = spreadsheet.getSheetByName(CONFIG.HOJA);

      if (!hoja) {

        throw new Error(
          'No existe la hoja "' + CONFIG.HOJA + '"'
        );

      }


      hoja.appendRow([

        fecha,

        hora,

        origen,

        nombre,

        empresa,

        ruc,

        correo,

        telefono,

        feria,

        tipoStand,

        medidas,

        presupuesto,

        comentarios,

        "NUEVO",

        ""

      ]);

    } finally {

      lock.releaseLock();

    }


    //==================================================
    // ENVIAR CORREO A COMERCIAL
    //==================================================

    enviarCorreoComercial({

      fecha,

      hora,

      origen,

      nombre,

      empresa,

      ruc,

      correo,

      telefono,

      feria,

      tipoStand,

      medidas,

      presupuesto,

      comentarios

    });


    return crearRespuesta(
      true,
      "Solicitud registrada correctamente"
    );


  } catch (error) {

    console.error(error);

    return crearRespuesta(
      false,
      "No se pudo registrar la solicitud"
    );

  }

}


