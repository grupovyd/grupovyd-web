//==================================================
// LIMPIAR TEXTO
//==================================================

function limpiarTexto(valor, maximo) {

  if (valor === null || valor === undefined) {

    return "";

  }

  return String(valor)
    .trim()
    .substring(0, maximo);

}


//==================================================
// VALIDAR CORREO
//==================================================

function validarCorreo(correo) {

  return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(correo);

}


//==================================================
// ESCAPAR HTML
//==================================================

function escaparHtml(texto) {

  return String(texto)

    .replace(/&/g, "&amp;")

    .replace(/</g, "&lt;")

    .replace(/>/g, "&gt;")

    .replace(/"/g, "&quot;")

    .replace(/'/g, "&#039;");

}


//==================================================
// RESPUESTA JSON
//==================================================

function crearRespuesta(exito, mensaje) {

  return ContentService

    .createTextOutput(

      JSON.stringify({

        success: exito,

        message: mensaje

      })

    )

    .setMimeType(
      ContentService.MimeType.JSON
    );

}